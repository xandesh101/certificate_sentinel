# Certificate Sentinel environment configuration
# Copy this file to .env and fill in real values
# .env is in .gitignore and must NEVER be committed

# Anthropic API key
# Get one at: https://console.anthropic.com
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Application password for the Streamlit gate
# Pick something memorable but not guessable
# Share separately from the URL when distributing
APP_PASSWORD=change-this-password

# Optional: model override
# Default: claude-sonnet-4-6
# Alternatives: claude-opus-4-7 (more expensive, stronger reasoning)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: max iterations in agent loop
# Default: 10
# AGENT_MAX_ITERATIONS=10

# Optional: per-session validation cap
# Default: 20
# SESSION_VALIDATION_CAP=20
